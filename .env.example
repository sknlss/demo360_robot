# Скопируйте в .env и заполните. Файл .env в репозиторий не попадает.
# Переменные окружения сильнее этого файла: в Docker значения из compose.yml не перебиваются.

# Токен бота от @BotFather. Обязательная.
BOT_TOKEN=

# Telegram-идентификаторы тех, кому в дашборде видно всё: телефоны целиком. Через запятую (узнать свой — @userinfobot).
# Это не список доступа: дашборд открывается любому с настоящей подписью Telegram,
# но остальные видят телефон замазанным (только последние 4 цифры). Пусто = полных телефонов не видит никто.
ADMIN_IDS=

# 1 = не проверять подпись Telegram, чтобы открыть дашборд в обычном браузере.
# ТОЛЬКО для локального запуска: при 1 данные видны любому, кто дошёл до порта, и телефоны показываются целиком.
DASHBOARD_AUTH_DISABLED=0

# Публичный https-адрес дашборда для кнопки в команде /dashboard (необязательно).
# Мини-апп в Telegram открывается только по https; локально можно не задавать.
# Адрес должен заканчиваться на «/» (если страница лежит по пути: https://example.com/tg-demo/) —
# страница запрашивает данные по относительным путям api/...; без «/» в конце запросы уйдут мимо.
# Если забыли, «/» допишется сам.
MINIAPP_URL=

# Адрес и порт веб-сервера дашборда. В контейнере compose.yml выставляет 0.0.0.0.
WEB_HOST=127.0.0.1
WEB_PORT=8080

# Файл базы SQLite. Рядом лежат bot.lock (замок) и photos/ (кеш фотографий профиля).
DB_PATH=data/bot.db

# Папка кеша фотографий профиля. По умолчанию photos/ рядом с файлом базы; обычно не нужна.
# PHOTO_CACHE_DIR=data/photos

# Файл с воронками.
CONFIG_PATH=funnels.yml

# Сколько секунд подпись Telegram считается свежей (по умолчанию сутки).
INIT_DATA_MAX_AGE=86400

# Для тестов: адрес заглушки Telegram API вместо настоящего (tests/fake_telegram.py).
TELEGRAM_API_BASE=

# Уровень журнала: DEBUG, INFO, WARNING.
LOG_LEVEL=INFO
